# Merge Guard commercial configuration
# The CLI reads process environment variables; it does not load this file automatically.
# Exact accepted values: production (default) or sandbox. URLs are not accepted.
MERGE_GUARD_POLAR_ENVIRONMENT=production
MERGE_GUARD_POLAR_ORGANIZATION_ID=
MERGE_GUARD_POLAR_PRO_BENEFIT_ID=
MERGE_GUARD_POLAR_TEAM_BENEFIT_ID=
MERGE_GUARD_PRO_CHECKOUT_URL=
MERGE_GUARD_TEAM_CHECKOUT_URL=
MERGE_GUARD_POLAR_CUSTOMER_PORTAL_URL=

# Optional overrides
# MERGE_GUARD_LICENSE_KEY=
# MERGE_GUARD_LICENSE_FILE=
# Sandbox appends .sandbox to this path (including a custom path).
# Never put real customer keys or organization access tokens in this file.

# Opt-in Sandbox example (use instead of production values in a separate shell):
# MERGE_GUARD_POLAR_ENVIRONMENT=sandbox
# MERGE_GUARD_POLAR_ORGANIZATION_ID=84897a3c-12b6-40b4-a96b-9e7b1681a352
# MERGE_GUARD_POLAR_PRO_BENEFIT_ID=bf34f3a6-a63a-4ccc-9d0e-882f5426dfa9
# MERGE_GUARD_POLAR_TEAM_BENEFIT_ID=
# MERGE_GUARD_PRO_CHECKOUT_URL=
# MERGE_GUARD_TEAM_CHECKOUT_URL=
# MERGE_GUARD_POLAR_CUSTOMER_PORTAL_URL=
