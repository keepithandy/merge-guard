{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/keepithandy/merge-guard/schemas/policy-manifest-v1.schema.json",
  "title": "Merge Guard repository policy manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "root"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "root": {
      "$ref": "#/$defs/rootScope"
    },
    "packages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/packageScope"
      },
      "default": []
    }
  },
  "$defs": {
    "starterPolicy": {
      "enum": ["frontend", "backend", "library", "browser-game", "infrastructure"]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {
          "enum": ["rule", "protectedPath", "requiredCheck"]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "pathPattern", "reason", "owner", "expires"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "pathPattern": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "expires": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "rootScope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy": {
          "$ref": "#/$defs/starterPolicy"
        },
        "exceptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/exception"
          },
          "default": []
        }
      }
    },
    "packageScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root"],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "inherit": {
          "type": "boolean",
          "default": true
        },
        "policy": {
          "$ref": "#/$defs/starterPolicy"
        },
        "exceptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/exception"
          },
          "default": []
        }
      }
    }
  }
}
